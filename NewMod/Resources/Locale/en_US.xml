    <string name="NewMod.Roles.NeutralRoles.EnergyThief.Tab.BreachCountdown">&lt;size=65%&gt;&lt;color=#FF5CEA&gt;GRID BREACH: {0:F1}s&lt;/color&gt;&lt;/size&gt;</string>
    <string name="NewMod.Roles.NeutralRoles.EnergyThief.Tab.ObjectiveReady">&lt;size=65%&gt;&lt;color=#75E6A5&gt;Power Node located. Reach it and breach the grid.&lt;/color&gt;&lt;/size&gt;</string>
