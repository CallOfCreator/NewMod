<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <VersionPrefix>1.3.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <Description>NewMod is a mod for Among Us that introduces a variety of new roles, unique abilities</Description>
        <Authors>CallofCreator</Authors>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <DebugType>embedded</DebugType>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release' ">
        <DefineConstants>TRACE;PC</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>recommended</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <CodeAnalysisRuleSet>stylecop.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
        <AdditionalFiles Include="stylecop.json" Visible="false" />
        <PackageReference Include="SonarAnalyzer.CSharp" Version="10.7.0.110445" PrivateAssets="all">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.0.1" PrivateAssets="all" ExcludeAssets="runtime">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735"/>
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34" PrivateAssets="all"/>
        <PackageReference Include="AllOfUs.MiraAPI" Version="0.5.0" PrivateAssets="all"/>
        <PackageReference Include="CallOfCreator.PathfindingAPI" Version="1.0.2" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*.*"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="CorsacCosmetics">
            <HintPath>Resources/Dlls/CorsacCosmetics.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Reactor">
            <HintPath>Resources/Dlls/Reactor.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AchievementsAPI">
            <HintPath>Resources/Dlls/AchievementsAPI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ReactUI">
            <HintPath>Resources/Dlls/ReactUI.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
