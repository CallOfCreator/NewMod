<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <VersionPrefix>1.3.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <Description>NewMod is a mod for Among Us that introduces a variety of new roles, unique abilities</Description>
        <Authors>CallofCreator</Authors>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <DebugType>embedded</DebugType>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release' ">
        <DefineConstants>TRACE;PC</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.8.18" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.0.1" PrivateAssets="all" ExcludeAssets="runtime">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735"/>
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34" PrivateAssets="all"/>
        <PackageReference Include="dev.xaine.AmongUsPatchAnalyzer" Version="2026.6.5" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*.*"/>
        <Compile Remove="Tests\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="CorsacCosmetics">
            <HintPath>Resources/CorsacCosmetics.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Reactor">
            <HintPath>Resources/Reactor.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="MiraAPI">
            <HintPath>Resources/MiraAPI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AchievementsAPI">
            <HintPath>Resources/AchievementsAPI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ReactUI">
            <HintPath>Resources/ReactUI.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
    <Target Name="MergeReactUI" AfterTargets="Build">
        <ItemGroup>
            <MergeInput Include="$(TargetPath)"/>
            <MergeInput Include="$(MSBuildProjectDirectory)/Resources/ReactUI.dll"/>
            <ILRepackSearchDir Include="@(ReferencePath->'%(RootDir)%(Directory)')"/>
        </ItemGroup>

        <MakeDir Directories="$(TargetDir)ilrepack_tmp"/>

        <ILRepack
                InputAssemblies="@(MergeInput)"
                LibraryPath="@(ILRepackSearchDir)"
                TargetKind="SameAsPrimaryAssembly"
                OutputFile="$(TargetDir)ilrepack_tmp/$(TargetFileName)"
                Internalize="true"
                RenameInternalized="true"/>

        <Delete Files="$(TargetPath)"/>

        <Move
                SourceFiles="$(TargetDir)ilrepack_tmp/$(TargetFileName)"
                DestinationFiles="$(TargetPath)"/>

        <RemoveDir Directories="$(TargetDir)ilrepack_tmp"/>
    </Target>
</Project>
